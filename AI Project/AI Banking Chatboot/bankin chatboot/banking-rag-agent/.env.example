# Application
APP_NAME=Banking RAG Agent
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=banking_rag

# JWT
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# LLM (OpenAI-compatible API - use OpenAI, Groq, or local Ollama)
LLM_API_KEY=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
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Embeddings (HuggingFace)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# RAG Settings
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=10
TOP_K_RERANK=5
RELEVANCE_THRESHOLD=0.35

# Vector Store
VECTOR_STORE_PATH=./vector_store/chroma

# File Upload
UPLOAD_DIR=./data/documents
MAX_UPLOAD_SIZE_MB=20

# Rate Limiting
RATE_LIMIT=30/minute

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
